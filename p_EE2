def es_perfecto(numero):
    suma = 0
    for divisor in range(1, numero):
        if numero % divisor == 0:
            suma += divisor
    return suma == numero

n = 0
while n <= 0:
    n = int(input("Ingrese un número entero positivo: "))

if es_perfecto(n):
    print(n, "SÍ es un número perfecto")
else:
    print(n, "NO es un número perfecto")
