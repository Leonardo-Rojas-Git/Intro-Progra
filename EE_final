def desviacion_puntajes(puntajes):
    N = len(puntajes)
    promedio = sum(puntajes) / len(puntajes)
    serie = 0
    # range(N) recorre desde el índice 0 hasta N-1 (todos los elementos)
    for i in range(N):
        serie = serie + (puntajes[i] - promedio)**2  # CLAVE acumular 
    desvi = ((1 / N) * serie)**(1 / 2)  # ojo paréntesis
    return desvi
